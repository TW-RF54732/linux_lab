# 已解決的舊錯誤：每一筆後面接著恢復訊息
INCIDENTS = [
    ("ERROR: database connection lost (timeout after 30s)",
     ["WARN: retrying db connection (attempt 1/5)",
      "WARN: retrying db connection (attempt 2/5)",
      "INFO: database connection restored"]),
    ("ERROR: failed to write /var/lib/app/cache/index.tmp (No space left on device)",
     ["WARN: disk usage at 99% on /var/lib/app",
      "INFO: cache cleanup freed 1.2 GB",
      "INFO: cache rebuilt"]),
    ("ERROR: upstream payment-api returned 502 Bad Gateway",
     ["WARN: retrying upstream payment-api (attempt 2/5)",
      "INFO: upstream payment-api recovered"]),
    ("ERROR: worker 4 crashed (exit code 137)",
     ["INFO: worker 4 restarted",
      "INFO: worker 4 ready"]),
    ("ERROR: failed to send daily report email (SMTP 451 temporary failure)",
     ["INFO: daily report email sent (retry 1)"]),
    ("ERROR: database connection lost (timeout after 30s)",
     ["WARN: retrying db connection (attempt 1/5)",
      "INFO: database connection restored"]),
    ("ERROR: certificate verify failed for inventory-api.internal",
     ["INFO: reloaded CA bundle",
      "INFO: upstream inventory-api recovered"]),
]


def fill(rng, template):
    return template.format(
        ms=rng.randint(3, 240),
        slow=rng.randint(1200, 4800),
        n=rng.randint(1, 999),
        w=rng.randint(1, 8),
        ratio=f"{rng.uniform(0.80, 0.99):.2f}",
        disk=rng.randint(78, 89),
    )


def gen_app_log(rng, now, final_error=True):
    start = now - timedelta(days=3)
    end = now - timedelta(minutes=4)
    stamps = spread(rng, start, end, 1940)

    lines = []
    for t in stamps:
        if rng.random() < 0.12:
            msg = "WARN: " + fill(rng, rng.choice(WARN_MSGS))
        else:
            msg = "INFO: " + fill(rng, rng.choice(INFO_MSGS))
        lines.append((t, msg))

    # 把舊錯誤平均插進前 90% 的時間軸
    for i, (err, recovery) in enumerate(INCIDENTS):
        frac = (i + 0.5 + rng.uniform(-0.3, 0.3)) / len(INCIDENTS) * 0.9
        t = start + (end - start) * frac
        lines.append((t, err))
        for msg in recovery:
            t += timedelta(seconds=rng.randint(5, 90))
            lines.append((t, msg))

    lines.sort(key=lambda x: x[0])

    # 結尾：設定被改掉 → app 重新啟動 → 讀設定失敗
    t = end + timedelta(seconds=30)
    tail = [
        "INFO: received reload request",
        "INFO: config reloaded",
        "INFO: shutting down workers",
        "INFO: stopped",
        "INFO: starting lab-app",
        "INFO: reading app/config.json",
    ]
    for msg in tail:
        t += timedelta(seconds=rng.randint(1, 20))
        lines.append((t, msg))
    final_t = now - timedelta(seconds=rng.randint(40, 90))
    if final_error:
        lines.append((max(final_t, t + timedelta(seconds=1)), FINAL_ERROR))

    return "".join(f"{t.strftime(TS)} {msg}\n" for t, msg in lines)


# ---------------------------------------------------------------- 其他 log

PATHS = ["/", "/index.html", "/api/items", "/api/items/{n}", "/api/orders",
         "/api/users/me", "/static/app.js", "/static/style.css", "/favicon.ico",
         "/login", "/logout", "/api/report"]
AGENTS = [
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36",
    "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Safari/605.1.15",
    "curl/8.5.0",
    "python-requests/2.31.0",
    "Mozilla/5.0 (X11; Linux x86_64; rv:132.0) Gecko/20100101 Firefox/132.0",
]


def gen_access_log(rng, now):
    tz = now.astimezone().strftime("%z")
    out = []
    for t in spread(rng, now - timedelta(days=2), now - timedelta(minutes=13), 3200):
        ip = f"10.{rng.randint(0, 3)}.{rng.randint(0, 20)}.{rng.randint(2, 254)}"
        method = "POST" if rng.random() < 0.15 else "GET"
        path = rng.choice(PATHS).format(n=rng.randint(1, 500))
        status = rng.choices([200, 304, 301, 404, 401, 500], [80, 8, 3, 6, 2, 1])[0]
        size = 0 if status == 304 else rng.randint(120, 48000)
        agent = rng.choice(AGENTS)
        out.append(f'{ip} - - [{t.strftime("%d/%b/%Y:%H:%M:%S")} {tz}] '
                   f'"{method} {path} HTTP/1.1" {status} {size} "-" "{agent}"\n')
    return "".join(out)


DB_MSGS = [
    "LOG:  checkpoint starting: time",
    "LOG:  checkpoint complete: wrote {n} buffers ({p}%); 0 WAL file(s) added, 0 removed, 1 recycled",
    "LOG:  automatic vacuum of table \"app.public.sessions\": index scans: 1",
