#!/usr/bin/env python3
# lab-seed：產生學員家目錄的預置檔案（~/.log、~/.config）。
#
# 內容由固定種子決定，同一個 --seed 每次產生的內容都相同；
# 時間戳以 --now（預設為現在）為終點往回推，所以開課當天重跑時，
# app.log 最後一筆 ERROR 會是「剛剛才發生」的樣子。
#
# 用法（root）：
#   lab-seed lab01                       # 產生 /home/lab01 的全部預置檔
#   lab-seed lab01 --only-app-log        # 只重寫 ~/.log/app.log
#   lab-seed --home /tmp/x --now "2026-11-21 14:00:00"   # 測試用，不 chown
#
# 只用 Python 標準函式庫。

import argparse
import json
import os
import pwd
import random
import socket
import sys
from datetime import datetime, timedelta
from pathlib import Path

DEFAULT_SEED = 20261116
FINAL_ERROR = 'ERROR: app is disabled, set "enable" to true in app/config.json'
TS = "%Y-%m-%d %H:%M:%S"


# ---------------------------------------------------------------- 工具

def spread(rng, start, end, count):
    """在 [start, end] 之間產生 count 個排序過的隨機時間點。"""
    span = (end - start).total_seconds()
    return sorted(start + timedelta(seconds=rng.uniform(0, span)) for _ in range(count))


def write(path, text, mtime, owner):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    os.chmod(path, 0o644)
    ts = mtime.timestamp()
    os.utime(path, (ts, ts))
    if owner:
        os.chown(path, owner.pw_uid, owner.pw_gid)


def mkdir(path, owner, mode=0o755):
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, mode)
    if owner:
        os.chown(path, owner.pw_uid, owner.pw_gid)


