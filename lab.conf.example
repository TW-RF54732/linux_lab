# Linux Server 社課 lab 設定範本。複製成 lab.conf 後修改（lab.conf 不進 git）：
#   cp lab.conf.example lab.conf
# setup.sh 與 verify.sh 會讀 lab.conf。

# 學員人數 N，帳號為 lab01 … labNN
LAB_COUNT=30
LAB_PREFIX=lab

# 管理者帳號（已存在的 Linux 帳號，空白分隔）。會加入 labadmins 群組才能 SSH 登入。
# 留空的話，部署後只能從 Proxmox 用 `pct enter <CTID>` 進入 CT（root 不能 SSH）。
LAB_ADMINS=""

# 時區：log 時間戳用
LAB_TZ="Asia/Taipei"

# 預置檔案的種子：同一個值產生的內容完全相同
LAB_SEED=20261116

# 每位使用者的資源上限（/etc/systemd/system/user-.slice.d/lab.conf）
LAB_TASKS_MAX=200
LAB_MEMORY_MAX=512M

# sshd MaxStartups，全班同時登入時避免被拒
LAB_MAX_STARTUPS="50:30:100"

# 學員密碼長度與名單位置（root 600）
LAB_PASSWORD_LEN=10
LAB_ROSTER=/root/lab-roster.csv
