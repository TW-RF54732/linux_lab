def auto_hint(pw):
    ch = challange_status(pw, proc_table())
    if ch["flag"] == OK or (ch["flag_html"] and not ch["evil"]):
        return 5
    if ch["evil_txt"] or ch["key"] == OK:
        return 4
    if ch["key"] != NONE or ch["x"]:
        return 3
    return 1


def cmd_hint(arg):
    pw = require_student()
    hs = hints(pw.pw_name)
    if arg is None:
        n = auto_hint(pw)
    else:
        try:
            n = int(arg)
        except ValueError:
            n = 0
        if not 1 <= n <= len(hs):
            sys.exit(f"lab：提示編號是 1 到 {len(hs)}")
    print(paint(f"提示 {n}/{len(hs)}", "1"))
    print(hs[n - 1])
    print()
    print(f"其他提示：lab hint 1 … lab hint {len(hs)}")


def save_answer(pw, name, value):
    d = Path(pw.pw_dir) / ".lab"
    d.mkdir(mode=0o700, exist_ok=True)
    (d / name).write_text(value + "\n", encoding="utf-8")


def cmd_submit(kind, args):
    pw = require_student()
    value = " ".join(args).strip()
    if not value:
        sys.exit("用法：lab flag '<flag>'" if kind == "flag" else "用法：lab bonus <文字>")
    h = load_hashes(pw.pw_name)
    if h is None:
        sys.exit("lab：還沒有你的答案資料，請找講師")
    if kind == "bonus":
        value = norm_bonus(value)
    if check_hash(h.get(kind), value):
        save_answer(pw, kind, value)
        print(paint(f"✓ {kind} 正確！", "32"))
        return
    print(paint(f"✗ {kind} 不對，再試試", "31"))
    if kind == "flag" and not value.startswith("flag"):
        print("  flag 要整串提交，包含 flag 和大括號，用單引號包起來")
    sys.exit(1)


# ---------------------------------------------------------------- 講師端

def require_root():
    if os.geteuid() != 0:
        sys.exit("lab：這個指令要 root（sudo lab …）")


def user_systemctl(pw, *args):
    return subprocess.run(
        ["runuser", "-u", pw.pw_name, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{pw.pw_uid}",
         "systemctl", "--user", *args],
        capture_output=True, text=True, timeout=30)


def pick_students(names):
    all_ = students()
    if not names:
        return all_
    by = {p.pw_name: p for p in all_}
    out = []
    for n in names:
        if n not in by:
            sys.exit(f"lab：{n} 不是學員（不在 {STUDENT_GROUP} 群組）")
        out.append(by[n])
    return out


def cmd_start_stop(start, names):
    require_root()
    fails = 0
    for pw in pick_students(names):
        if start:
            user_systemctl(pw, "daemon-reload")
            p = user_systemctl(pw, "enable", "--now", SERVICE)
        else:
            p = user_systemctl(pw, "disable", "--now", SERVICE)
        if p.returncode == 0:
            print(f"  {paint('ok', '32')}  {pw.pw_name}")
        else:
            fails += 1
            print(f"  {paint('!!', '31')}  {pw.pw_name}：{(p.stderr or p.stdout).strip()}")
    sys.exit(1 if fails else 0)


def cmd_reset(names):
    require_root()
    if not names:
        sys.exit("用法：lab --reset <帳號>…")
    fails = 0
    for pw in pick_students(names):
        was = user_systemctl(pw, "is-active", "--quiet", SERVICE).returncode == 0
        user_systemctl(pw, "disable", "--now", SERVICE)
        user_systemctl(pw, "reset-failed", SERVICE)
        p = subprocess.run([BUILDER, "build", "--force", pw.pw_name], capture_output=True, text=True)
        if p.returncode != 0:
            fails += 1
            print(f"  {paint('!!', '31')}  {pw.pw_name}：{(p.stderr or p.stdout).strip()}")
            continue
        if was:
            user_systemctl(pw, "enable", "--now", SERVICE)
        print(f"  {paint('ok', '32')}  {pw.pw_name} 已重置" + ("，evil-killer 已重新啟動" if was else ""))
    sys.exit(1 if fails else 0)


def collect_all():
    pws = students()
    procs = proc_table()
    since = min((lesson_baseline(p.pw_name) for p in pws), default=time.time())
    journal = journal_events(since)
    rows = []
    for pw in pws:
        lesson, online = lesson_status(pw, procs, journal)
        rows.append((pw, online, lesson, challange_status(pw, procs)))
    return rows, journal is not None


def cmd_all(as_json):
    require_root()
    rows, journal_ok = collect_all()
    if as_json:
        out = {}
        for pw, online, lesson, ch in rows:
            out[pw.pw_name] = {
                "online": online,
                "lesson": {k: v[0] for k, v in lesson.items()},
                "lesson_notes": {k: v[1] for k, v in lesson.items()},
                "challange": ch,
            }
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return

    def yes(b):
        return OK if b else NONE

    cols = ["帳號", "在線", "1登入", "2金鑰", "3報告", "5服務", "│", "鑰", "吃", "停", "flag", "bonus", "evil", "備註"]
    table = []
    done = [0] * len(cols)
    for pw, online, lesson, ch in rows:
        stopped = ch["evil_txt"] and not ch["evil"]
        states = [lesson["login"][0], lesson["key"][0], lesson["report"][0], lesson["service"][0],
                  ch["key"], yes(ch["evil_txt"]), yes(stopped), ch["flag"], ch["bonus"]]
        note = next((lesson[k][1] for k in ("login", "key", "report", "service")
                     if lesson[k][0] != OK and lesson[k][1]), "")
        if not note and lesson["service"][0] == OK and lesson["service"][1] != "執行中":
            note = lesson["service"][1]
        cells = [pw.pw_name, paint("●", "32") if online else mark(NONE)]
        cells += [mark(s) for s in states[:4]] + ["│"] + [mark(s) for s in states[4:]]
        cells += [paint("跑", "33") if ch["evil"] else mark(NONE), note]
        for i, s in enumerate(states):
            if s == OK:
                done[i + 2 + (1 if i >= 4 else 0)] += 1
        done[1] += online
        done[12] += ch["evil"]
        table.append(cells)

    widths = [max([width(c)] + [width(r[i]) for r in table]) for i, c in enumerate(cols)]
    widths[-1] = 0

    def line(cells):
        return "  ".join(pad(c, widths[i]) for i, c in enumerate(cells)).rstrip()

    n = len(rows)
    print(paint(f"lab 進度  {datetime.now():%H:%M:%S}  學員 {n} 人", "1")
          + ("" if journal_ok else paint("  （journal 讀不到：登入/金鑰/下載無法判斷）", "33")))
    print(paint("✓ 完成  △ 做一半  ✗ 有問題  · 還沒做    鑰=密鑰放對 吃=flag 被吃過 停=停掉 evil-killer", "2"))
    print()
    print(paint(line(cols), "1"))
    for r in table:
        print(line(r))
    foot = ["完成"] + [str(d) for d in done[1:6]] + ["│"] + [str(d) for d in done[7:13]] + [""]
    print(paint(line(foot), "1"))


def cmd_watch(args):
    """自己重畫畫面，不經過 ncurses，所以不受 locale 影響。"""
    require_root()
    interval = 5.0
    if args:
        try:
            interval = max(1.0, float(args[0]))
        except ValueError:
            sys.exit("用法：lab --watch [秒數]")
    out = sys.stdout
    try:
        out.write("\033[?25l")  # 隱藏游標
        while True:
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                cmd_all(False)
            footer = paint(f"\n每 {interval:g} 秒更新，Ctrl+C 離開", "2")
            out.write("\033[H\033[J" + buf.getvalue() + footer)
            out.flush()
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        out.write("\033[?25h\n")
        out.flush()


# ---------------------------------------------------------------- main

USAGE = """\
學員：
  lab                    看自己的進度
  lab hint [N]           提示（不加 N 會依目前進度挑一則）
  lab flag '<flag>'      提交 flag
  lab bonus <文字>       提交 bonus
講師（root）：
  lab --start [帳號…]    啟動 evil-killer（enable --now）
  lab --stop  [帳號…]    停止 evil-killer（disable --now）
  lab --all [--json]     計分板（印一次）
  lab --watch [秒數]     計分板自動更新（預設 5 秒），投影用
  lab --reset 帳號…      重置學員的 challange"""


def main():
    # 終端機幾乎都是 UTF-8；locale 不是 UTF-8 時也照樣輸出中文，不要整個當掉
    if (sys.stdout.encoding or "").lower().replace("-", "") != "utf8":
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    a = sys.argv[1:]
    if not a:
        if os.geteuid() == 0:
            print(USAGE)
            return
        cmd_status()
    elif a[0] in ("-h", "--help", "help"):
        print(USAGE)
    elif a[0] == "hint":
        cmd_hint(a[1] if len(a) > 1 else None)
    elif a[0] in ("flag", "bonus"):
        cmd_submit(a[0], a[1:])
    elif a[0] == "--start":
        cmd_start_stop(True, a[1:])
    elif a[0] == "--stop":
        cmd_start_stop(False, a[1:])
    elif a[0] == "--all":
        cmd_all("--json" in a[1:])
    elif a[0] == "--watch":
        cmd_watch(a[1:])
    elif a[0] == "--reset":
        cmd_reset(a[1:])
    else:
        sys.exit(f"lab：不認得「{a[0]}」\n\n{USAGE}")


if __name__ == "__main__":
    main()
