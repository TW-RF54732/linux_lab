SYMBOL = {OK: "✓", PART: "△", BAD: "✗", NONE: "·", UNK: "?"}


def paint(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR and code else text


def mark(state):
    return paint(SYMBOL[state], COLORS[state])


def width(s):
    s = re.sub(r"\033\[[0-9;]*m", "", s)
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s, w):
    return s + " " * max(0, w - width(s))


# ---------------------------------------------------------------- 共用工具

def read_text(path, limit=None):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read(limit) if limit else f.read()
    except OSError:
        return None


def first_line(path):
    t = read_text(path, 4096)
    return None if t is None else t.split("\n", 1)[0]


def students():
    try:
        names = grp.getgrnam(STUDENT_GROUP).gr_mem
    except KeyError:
        return []
    out = []
    for n in sorted(set(names)):
        try:
            out.append(pwd.getpwnam(n))
        except KeyError:
            pass
    return out


def proc_table():
    """uid → 該使用者所有程序的名稱（comm）集合。一次掃完 /proc，不必每人跑 pgrep。"""
    table = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        name = uid = None
        try:
            with open(f"/proc/{pid}/status", encoding="utf-8", errors="replace") as f:
                for line in f:
                    if line.startswith("Name:"):
                        name = line.split(None, 1)[1].strip()
                    elif line.startswith("Uid:"):
                        uid = int(line.split()[1])
                        break
        except (OSError, ValueError, IndexError):
            continue
        if name is not None and uid is not None:
            table.setdefault(uid, set()).add(name)
    return table


def lesson_baseline(user):
    t = read_text(LESSON_DIR / user, 64)
    try:
        return float(t.strip())
    except (AttributeError, ValueError):
        return datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()


def student_number(user):
    m = re.search(r"(\d+)$", user)
    return int(m.group(1)) if m else 0


def check_hash(entry, value):
    try:
        salt = bytes.fromhex(entry["salt"])
        want = bytes.fromhex(entry["sha256"])
        it = int(entry["iter"])
    except (KeyError, TypeError, ValueError):
        return False
    return hmac.compare_digest(hashlib.pbkdf2_hmac("sha256", value.encode(), salt, it), want)


def norm_bonus(s):
    return re.sub(r"\s+", "", s or "").upper()


# ---------------------------------------------------------------- journal（root）

JOURNAL_IDS = ["sshd", "sshd-session", "internal-sftp", "sftp-server"]
RE_ACCEPT = re.compile(r"^Accepted (\S+) for (\S+) from ")
RE_SFTP_USER = re.compile(r"^session opened for local user (\S+) from ")
RE_SFTP_OPEN = re.compile(r'^open "([^"]*)" flags (\S+)')


def journal_events(since):
    """回傳 {user: {"login": [ts], "pubkey": [ts], "download": [ts]}}；journal 讀不到回傳 None。"""
    cmd = ["journalctl", "-q", "--no-pager", "-o", "json",
           "--output-fields=MESSAGE,SYSLOG_PID,_PID", f"--since=@{int(since)}"]
    cmd += [f"SYSLOG_IDENTIFIER={i}" for i in JOURNAL_IDS]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    ev = {}
    sftp_pid = {}
    for line in p.stdout.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE")
        if isinstance(msg, list):
            msg = bytes(msg).decode("utf-8", "replace")
        if not isinstance(msg, str):
            continue
        ts = int(e.get("__REALTIME_TIMESTAMP", 0)) / 1e6
        pid = e.get("SYSLOG_PID") or e.get("_PID")
        m = RE_ACCEPT.match(msg)
        if m:
            d = ev.setdefault(m.group(2), {})
            d.setdefault("login", []).append(ts)
            if m.group(1) == "publickey":
                d.setdefault("pubkey", []).append(ts)
            continue
        m = RE_SFTP_USER.match(msg)
        if m:
            sftp_pid[pid] = m.group(1)
            continue
        m = RE_SFTP_OPEN.match(msg)
        if m and pid in sftp_pid and "READ" in m.group(2) and m.group(1).endswith("error.txt"):
            ev.setdefault(sftp_pid[pid], {}).setdefault("download", []).append(ts)
    return ev


# ---------------------------------------------------------------- 教學關卡檢查點

def check_authorized_keys(home):
    ssh = home / ".ssh"
    ak = ssh / "authorized_keys"
    text = read_text(ak) if ak.exists() else None
    # setup 會預建空的 authorized_keys，空檔和不存在一樣當作「還沒放」
    if text is None or not text.strip():
        if (home / "id_ed25519.pub").exists() or list(home.glob("*.pub")):
            return PART, "公鑰傳上來了，還沒放進 ~/.ssh/authorized_keys"
        return NONE, ""
    if not re.search(r"^\s*(ssh-(ed25519|rsa|dss)|ecdsa-sha2-|sk-)", text, re.M):
        return BAD, "authorized_keys 裡沒有公鑰（被 > 蓋掉了？）"
    for p, what in ((home, "家目錄"), (ssh, "~/.ssh"), (ak, "authorized_keys")):
        try:
            if p.stat().st_mode & 0o022:
                return BAD, f"{what}的權限讓群組或其他人可寫，sshd 會拒用金鑰"
        except OSError:
            pass
    return PART, "公鑰放好了，exit 後重新登入應該不用密碼"


REPORT_DIRS = ("reports", "report")  # 講師版文件寫 reports，課堂上也可能教 report，兩個都認


def check_report(home):
    found = [d for d in REPORT_DIRS if (home / d / "error.txt").exists()]
    for d in found:
        if SEED_ERROR in (read_text(home / d / "error.txt") or ""):
            return PART, "報告做好了，記得 scp 回筆電"
    if found:
        return BAD, f"{found[0]}/error.txt 沒有最後那筆 ERROR"
    if (home / "error.txt").exists():
        return PART, "error.txt 還沒搬到 ~/reports"
    return NONE, ""


def check_service(home, running):
    log = read_text(home / ".log" / "app.log")
    if log is None:
        return UNK, "讀不到 app.log"
    lines = log.splitlines()
    # 只看 setup 時 lab-app 自己寫的那筆 app is disabled 之後（預置的舊 log 不算）
    start = next((i for i, l in enumerate(lines) if SEED_ERROR in l), -1)
    after = lines[start + 1:]
    if any(l.endswith(" INFO: started") for l in after):
        return OK, "執行中" if running else "啟動過，目前沒在跑"
    errs = [l for l in after if " ERROR: " in l]
    if not errs:
        return NONE, ""
    last = errs[-1]
    for key, desc in APP_ERRORS:
        if key in last:
            return BAD, f"lab-app：{desc}"
    # 不是 lab-app 會寫的錯誤（例如 app.log 被 > 蓋掉、只剩預置的舊錯誤）：當作還沒動
    return NONE, ""


def lesson_status(pw, procs, journal):
    """journal 為 None 表示學員端（或 journal 讀不到）。"""
    user, home = pw.pw_name, Path(pw.pw_dir)
    comms = procs.get(pw.pw_uid, set())
    online = bool(comms & {"sshd", "sshd-session"})
    base = lesson_baseline(user)
    res = {}
    is_root = os.geteuid() == 0

    if not is_root:
        res["login"] = (OK, "")
    elif journal is None:
        res["login"] = (OK, "") if online else (UNK, "journal 讀不到")
    else:
        ev = journal.get(user, {})
        res["login"] = (OK, "") if online or any(t >= base for t in ev.get("login", [])) else (NONE, "")

    key = check_authorized_keys(home)
    if is_root and journal is not None:
        if any(t >= base for t in journal.get(user, {}).get("pubkey", [])):
            key = (OK, "")
    elif not is_root:
        info = read_text(os.environ.get("SSH_USER_AUTH", ""), 4096) if os.environ.get("SSH_USER_AUTH") else None
        if info and re.search(r"^publickey ", info, re.M):
            key = (OK, "這次是用金鑰登入的")
    res["key"] = key

    rpt = check_report(home)
    if is_root and journal is not None:
        if any(t >= base for t in journal.get(user, {}).get("download", [])):
            rpt = (OK, "")
    res["report"] = rpt

    res["service"] = check_service(home, "lab-app" in comms)
    return res, online


# ---------------------------------------------------------------- challange

def challange_status(pw, procs):
    user, home = pw.pw_name, Path(pw.pw_dir)
    chal = home / CHAL_DIRNAME
    st = {}
    try:
        st["x"] = bool((chal / "decoder.sh").stat().st_mode & 0o100)
    except OSError:
        st["x"] = False

    kf = chal / "key.txt"
    if not (kf.exists() or kf.is_symlink()):
        st["key"] = NONE
    else:
        mine, real = first_line(kf), first_line(KEY_PATH)
        st["key"] = OK if mine is not None and mine == real else PART

    st["evil_txt"] = (chal / "evil.txt").exists()
    st["flag_html"] = (chal / "flag.html").exists()
    st["evil"] = "evil-killer" in procs.get(pw.pw_uid, set())

    sub_flag = (read_text(home / ".lab" / "flag", 256) or "").strip()
    sub_bonus = norm_bonus(read_text(home / ".lab" / "bonus", 256))
    if os.geteuid() == 0:
        try:
            ans = json.loads(read_text(ANSWERS_DIR / f"{user}.json") or "")
            st["flag"] = OK if sub_flag and sub_flag == ans["flag"] else NONE
            st["bonus"] = OK if sub_bonus and sub_bonus == ans["bonus"].upper() else NONE
        except (ValueError, KeyError, TypeError):
            st["flag"] = st["bonus"] = UNK
    else:
        h = load_hashes(user)
        if h is None:
            st["flag"] = st["bonus"] = UNK
        else:
            st["flag"] = OK if sub_flag and check_hash(h.get("flag"), sub_flag) else NONE
            st["bonus"] = OK if sub_bonus and check_hash(h.get("bonus"), sub_bonus) else NONE
    return st


def load_hashes(user):
    try:
        return json.loads(read_text(USERS_DIR / f"{user}.json") or "")
    except ValueError:
        return None


