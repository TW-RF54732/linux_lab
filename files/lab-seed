    "LOG:  connection received: host=10.0.1.{h} port={port}",
    "LOG:  connection authorized: user=app database=app",
    "LOG:  disconnection: session time: 0:0{m}:{s:02d}.{ms:03d} user=app database=app host=10.0.1.{h}",
    "LOG:  duration: {dur}.{ms:03d} ms  statement: SELECT * FROM items WHERE id = {n}",
    "WARNING:  there is already a transaction in progress",
]


def gen_db_log(rng, now):
    out = []
    for t in spread(rng, now - timedelta(days=3), now - timedelta(minutes=14), 900):
        msg = rng.choice(DB_MSGS).format(
            n=rng.randint(10, 900), p=rng.randint(0, 9), h=rng.randint(2, 40),
            port=rng.randint(40000, 60000), m=rng.randint(0, 9), s=rng.randint(0, 59),
            ms=rng.randint(0, 999), dur=rng.randint(1, 900))
        out.append(f"{t.strftime(TS)}.{rng.randint(0, 999):03d} CST [{rng.randint(1000, 9999)}] {msg}\n")
    return "".join(out)


def gen_cron_log(rng, now, host):
    out = []
    t = (now - timedelta(days=3)).replace(minute=0, second=0, microsecond=0)
    while t < now - timedelta(minutes=15):
        for minute in (0, 10, 17, 20, 30, 40, 50):
            ts = t.replace(minute=minute, second=1)
            pid = rng.randint(1000, 30000)
            if minute == 17:
                out.append(f"{ts:%b %d %H:%M:%S} {host} CRON[{pid}]: (root) CMD "
                           f"(   cd / && run-parts --report /etc/cron.hourly)\n")
            elif minute in (10, 20, 40, 50):
                out.append(f"{ts:%b %d %H:%M:%S} {host} CRON[{pid}]: (app) CMD "
                           f"(/usr/local/bin/app-healthcheck --timeout 5)\n")
            elif minute == 0:
                out.append(f"{ts:%b %d %H:%M:%S} {host} CRON[{pid}]: (app) CMD "
                           f"(/usr/local/bin/app-sync --quiet)\n")
            else:
                out.append(f"{ts:%b %d %H:%M:%S} {host} CRON[{pid}]: (app) CMD "
                           f"(/usr/local/bin/app-metrics >/dev/null 2>&1)\n")
                if rng.random() < 0.3:
                    out.append(f"{ts:%b %d %H:%M:%S} {host} CRON[{pid}]: (CRON) info "
                               f"(No MTA installed, discarding output)\n")
        if t.hour == 6:
            ts = t.replace(minute=25, second=1)
            out.append(f"{ts:%b %d %H:%M:%S} {host} CRON[{rng.randint(1000, 30000)}]: (root) CMD "
                       f"(test -x /usr/sbin/anacron || {{ cd / && run-parts --report /etc/cron.daily; }})\n")
        t += timedelta(hours=1)
    return "".join(out)


BOOT_UNITS = [
    "Journal Service", "Load Kernel Modules", "Remount Root and Kernel File Systems",
    "Create System Users", "Apply Kernel Variables", "Create Static Device Nodes in /dev",
    "Network Configuration", "Network Name Resolution", "Permit User Sessions",
    "D-Bus System Message Bus", "User Login Management", "OpenBSD Secure Shell server",
    "Regular background program processing daemon", "System Logging Service",
    "Daily apt download activities", "Daily Cleanup of Temporary Directories",
    "Record System Boot/Shutdown in UTMP", "Update UTMP about System Runlevel Changes",
    "Set console font and keymap", "Create Volatile Files and Directories",
]


def gen_boot_log(rng, now):
    out = []
    for boot in range(3):
        stamp = now - timedelta(days=3 - boot, hours=rng.randint(0, 5))
        out.append(f"------------ {stamp:%a %b %d %H:%M:%S %Y} ------------\n")
        for _ in range(rng.randint(90, 110)):
            unit = rng.choice(BOOT_UNITS)
            kind = rng.choices(["Starting", "Started", "Reached", "Finished"], [4, 5, 1, 2])[0]
            if kind == "Starting":
                out.append(f"         Starting {unit}...\n")
            elif kind == "Reached":
                out.append(f"[  OK  ] Reached target {rng.choice(['Basic System', 'Network', 'Multi-User System', 'Timers', 'Sockets'])}.\n")
            else:
                out.append(f"[  OK  ] {kind} {unit}.\n")
    return "".join(out)


# ---------------------------------------------------------------- ~/.config

def config_files():
    j = lambda d: json.dumps(d, indent=2, ensure_ascii=False) + "\n"
    return {
        "app/config.json": '{"enable": false}\n',
        "backup-agent/config.json": j({
            "enable": True, "schedule": "0 3 * * *",
            "target": "/srv/backup", "keep_days": 14}),
        "monitor/config.json": j({
            "enable": True, "interval_seconds": 30,
            "checks": ["disk", "memory", "http"], "alert_email": "ops@example.com"}),
        "chat-bot/config.json": j({
            "enable": False, "channel": "#general", "greeting": "hello!"}),
        "notes/settings.ini": "[general]\nsort = modified\nfont_size = 14\n\n[sync]\nenabled = no\n",
        "theme/colors.conf": "background=#1e1e2e\nforeground=#cdd6f4\naccent=#89b4fa\n",
        "weather-widget/widget.toml": 'city = "Taipei"\nunits = "metric"\nrefresh_minutes = 30\n',
        "editor-sync/state.yml": "last_sync: never\ndevices: []\n",
    }


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description="產生 lab 學員的預置檔案")
    ap.add_argument("user", nargs="?", help="學員帳號；以 root 執行時會 chown 給此帳號")
    ap.add_argument("--home", help="家目錄（預設為帳號的家目錄）")
    ap.add_argument("--now", help='時間軸終點，格式 "YYYY-MM-DD HH:MM:SS"，預設為現在')
    ap.add_argument("--seed", type=int, default=DEFAULT_SEED)
    ap.add_argument("--only-app-log", action="store_true", help="只重寫 ~/.log/app.log")
    ap.add_argument("--no-final-error", action="store_true",
                    help="app.log 不寫最後那筆 ERROR，改由接著啟動的 lab-app 自己寫（setup.sh 用）")
    args = ap.parse_args()

    owner = None
    if args.user:
        try:
            owner = pwd.getpwnam(args.user)
        except KeyError:
            sys.exit(f"lab-seed: no such user: {args.user}")
    if os.geteuid() != 0:
        owner = None  # 非 root 無法 chown，測試時用
    home = Path(args.home or (owner.pw_dir if owner else ""))
    if not args.home and not owner:
        sys.exit("lab-seed: need a user (as root) or --home")

    now = datetime.strptime(args.now, TS) if args.now else datetime.now().replace(microsecond=0)
    host = socket.gethostname().split(".")[0]

    log_dir = home / ".log"
    mkdir(log_dir, owner)

    # 每個檔案各自用衍生種子，這樣只重寫 app.log 時內容也一致
    def rng(name):
        return random.Random(f"{args.seed}:{name}")

    write(log_dir / "app.log", gen_app_log(rng("app"), now, not args.no_final_error), now, owner)
    if args.only_app_log:
        return

    write(log_dir / "access.log", gen_access_log(rng("access"), now), now - timedelta(minutes=13), owner)
    write(log_dir / "db.log", gen_db_log(rng("db"), now), now - timedelta(minutes=14), owner)
    write(log_dir / "cron.log", gen_cron_log(rng("cron"), now, host), now - timedelta(minutes=15), owner)
    write(log_dir / "boot.log", gen_boot_log(rng("boot"), now), now - timedelta(days=1, hours=2), owner)

    cfg = home / ".config"
    mkdir(cfg, owner)
    r = rng("mtime")
    for rel, text in config_files().items():
        path = cfg / rel
        mkdir(path.parent, owner)
        mtime = now - timedelta(days=r.randint(3, 40), minutes=r.randint(0, 1440))
        if rel == "app/config.json":
            mtime = now - timedelta(minutes=14)
        write(path, text, mtime, owner)


if __name__ == "__main__":
    main()
